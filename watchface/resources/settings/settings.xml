                <listEntry value="0">@Strings.FieldNone</listEntry>
                <listEntry value="1">@Strings.FieldSteps</listEntry>
                <listEntry value="2">@Strings.FieldHeart</listEntry>
                <listEntry value="3">@Strings.FieldDistance</listEntry>
                <listEntry value="4">@Strings.FieldElevation</listEntry>
                <listEntry value="5">@Strings.FieldSun</listEntry>
                <listEntry value="6">@Strings.FieldTemp</listEntry>
                <listEntry value="7">@Strings.FieldCalories</listEntry>
                <listEntry value="8">@Strings.FieldFloors</listEntry>
                <listEntry value="9">@Strings.FieldActive</listEntry>
            </settingConfig>
        </setting>
